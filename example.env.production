# ============================================================
# SUNY Parking — Production Environment Variables Template
# ============================================================
# Copy this file to .env and fill in production values.
# NEVER commit .env or this file once it contains real values.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DB_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PRODUCTION_PASSWORD

DATABASE_URL=postgresql+psycopg2://postgres:REPLACE_WITH_STRONG_UNIQUE_PRODUCTION_PASSWORD@db:5432/suny_prod

# ── JWT Authentication ────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# Use a minimum 64-character key in production
SECRET_KEY=REPLACE_WITH_MINIMUM_64_CHARACTER_RANDOMLY_GENERATED_SECRET

# Shorter expiry recommended for production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Frontend ──────────────────────────────────────────────────
VITE_BACKEND_URL=https://your-production-domain.com

# ── PostgreSQL (Docker) ───────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_DB=suny_prod

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins — never use * in production
ALLOWED_ORIGINS=https://your-production-domain.com

# ── SSL / HTTPS ───────────────────────────────────────────────
# Handled by Nginx/Traefik reverse proxy — not by the app directly
# Ensure all traffic is HTTPS before exposing publicly
