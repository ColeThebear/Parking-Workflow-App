# ============================================================
# SUNY Parking — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Strong, unique password — no special chars that break URLs unless URL-encoded
DB_PASSWORD=your_secure_database_password_here

DATABASE_URL=postgresql+psycopg2://postgres:your_secure_database_password_here@db:5432/suny_dev

# ── JWT Authentication ────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters
SECRET_KEY=your_secret_key_at_least_32_characters_here

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Frontend ──────────────────────────────────────────────────
VITE_BACKEND_URL=http://localhost:8000

# ── Observability ─────────────────────────────────────────────
# Sentry DSN — leave empty to disable error tracking (safe for local dev)
# Get your DSN from https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=

# ENVIRONMENT tag sent to Sentry: development | staging | production
ENVIRONMENT=development

# Set to false for human-readable logs in local dev; true for JSON in prod
LOG_JSON=true

# ── PostgreSQL (Docker) ───────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_DB=suny_dev
